# Copy to .env at the repo root. Both apps read it.

NODE_ENV=development
# Public URL of the web app (used in emailed links)
APP_URL=http://localhost:3000

# ---------- API ----------
API_PORT=4000
DATABASE_URL=postgres://phoenix:phoenix@localhost:5432/phoenix
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64. Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=phx_session
SESSION_TTL_DAYS=30
# Express "trust proxy" value: loopback, true, a number of hops, or a CIDR list
TRUST_PROXY=loopback
LOG_LEVEL=info
# Mail adapter: console prints emails to the worker log (development)
MAIL_PROVIDER=console
MAIL_FROM="Phoenix Platform <no-reply@phoenix.test>"
# Password given to the seeded demo users (development only)
SEED_PASSWORD=Phoenix@12345

# ---------- Integrations (docs/platform/INTEGRATIONS.md) ----------
# Mock adapters (WhatsApp, email, SMS, calls, meetings, calendars, payments, e-sign, AI, storage):
# auto = on outside production and off in production; on / off force it.
INTEGRATIONS_MOCKS=auto
# Folder for the local-disk storage mock (default: .data/storage in the repository)
INTEGRATIONS_LOCAL_STORAGE_DIR=
# Requests per minute for each API key (Authorization: Bearer phx_...)
API_KEY_RATE_LIMIT=600

# ---------- Webhooks and background jobs (docs/platform/WEBHOOKS_AND_JOBS.md) ----------
# Attempts before a webhook event or a background job is dead-lettered
WEBHOOK_MAX_ATTEMPTS=12
JOB_MAX_ATTEMPTS=5
# Exponential backoff between attempts: first delay and cap, in milliseconds
RETRY_BASE_DELAY_MS=10000
RETRY_MAX_DELAY_MS=3600000
# Days processed webhook events are kept (redeliveries are recognised within this window)
WEBHOOK_RETENTION_DAYS=30
# Public webhook URL limits: deliveries per connection per minute, and refused deliveries
# (unknown connection, bad signature, unreadable body) per source IP per 10 minutes
WEBHOOK_RATE_LIMIT=1200
WEBHOOK_FAILURE_LIMIT=100
# Outbound throttling overrides as JSON, e.g. {"whatsapp":{"perSecond":20,"burst":40}}
THROTTLE_LIMITS=

# ---------- AI service (docs/platform/AI.md) ----------
# The Claude API key is not an env var: it is a credential of the company's AI connection
# (Settings > Integrations, provider Anthropic Claude). These tune the adapter and the runner.
# Model id when the connection does not set one
AI_MODEL=claude-opus-5-5
# Per model call, and attempts on retryable errors (429, 529, 5xx, timeouts)
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS=3
# on: a refused request is re-run on the model Anthropic recommends (server-side fallbacks)
AI_REFUSAL_FALLBACK=on
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- Web ----------
# Where the Next.js server forwards /api/v1 requests. Read by `next dev` and baked in by
# `next build`, so set it before building for production.
API_INTERNAL_URL=http://localhost:4000
