{
  "name": "@phoenix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "worker:dev": "node --watch src/worker.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "db:migrate": "node src/db/cli.js migrate",
    "db:rollback": "node src/db/cli.js rollback",
    "db:seed": "node src/db/cli.js seed",
    "db:reset": "node src/db/cli.js reset",
    "org:create-group": "node src/cli/create-group.js",
    "roles:sync": "node src/cli/sync-roles.js",
    "search:reindex": "node src/cli/search-reindex.js",
    "timeline:archive": "node src/cli/timeline-archive.js",
    "test": "node --test --test-concurrency=1",
    "test:integration": "INTEGRATION=1 node --test --test-concurrency=1"
  },
  "dependencies": {
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "knex": "^3.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  }
}
